VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Serve quiz media (images/audio) as short-lived signed URLs with opaque,
# unguessable file names instead of predictable public URLs. Leave off (unset)
# until the media has been renamed on Storage (scripts/rename-media.mjs) and
# MEDIA_SECRET is set on the server, then set to "true". See scripts/rename-media.mjs.
VITE_SIGNED_MEDIA=false

# Server-side only (used by api/*.js) - never prefix these with VITE_, or
# Vite would bundle them into client-side code.
STRIPE_SECRET_KEY=sk_test_your-secret-key
# From Stripe dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# From Supabase dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Secret that derives the opaque, unguessable media file names (HMAC key). Used
# by api/media and the rename script - the two MUST use the same value. Any long
# random string; keep it secret and stable (rotating it renames every file).
MEDIA_SECRET=your-long-random-media-secret
# Groq API key - powers the AI evaluation of Expression écrite (chat) and
# Expression orale (Whisper transcription + chat). From
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key
# Azure Speech - voices the AI examiner in the oral-interview simulation.
# Optional: without it the dialogue is text-only (browser TTS fallback).
# Key + region from Azure Portal -> your Speech resource -> Keys and Endpoint
# (region is the short id, e.g. "canadacentral", "eastus"). Voice is any
# neural voice name; fr-CA-SylvieNeural is the default. Set on Vercel for prod.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=canadacentral
AZURE_SPEECH_VOICE=fr-CA-SylvieNeural

# --- Transactional email (subscription reminders) ---------------------------
# SMTP for the Hostinger mailbox that sends the "expires in 3 days" and
# "expired" emails. User/pass are the mailbox's own login (contact@...).
# Host/port default to Hostinger's (smtp.hostinger.com : 465, implicit TLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@tcfpasserelle.com
SMTP_PASS=your-mailbox-password
# Optional: display name + reply-to shown to recipients (defaults to SMTP_USER).
MAIL_FROM_NAME=Passerelle TCF
MAIL_FROM_ADDR=contact@tcfpasserelle.com
# Public site URL used for the "Renew" button in reminder emails.
SITE_URL=https://tcfpasserelle.com
# Shared secret that authorizes the Vercel cron call to /api/cron/reminders.
# Any long random string; set the SAME value in the Vercel project settings.
CRON_SECRET=your-long-random-cron-secret

# --- Vercel Web Analytics (admin "Trafic" tab) -------------------------------
# Feeds the visitors / page views / top pages breakdown in the admin dashboard
# by reading Vercel's own Web Analytics API server-side (api/_lib/admin/vercel.js).
# Collection itself needs no key - <Analytics /> in App.jsx already reports every
# visit; these vars only let the dashboard READ the numbers back. Leave them
# unset and the tab shows its setup instructions instead of failing.
# Prerequisite: Web Analytics enabled on the project (Vercel -> Analytics tab).
# Token from https://vercel.com/account/tokens (read scope on this project is enough).
VERCEL_ANALYTICS_TOKEN=your-vercel-access-token
# Project id (prj_...) from Vercel -> project -> Settings -> General.
VERCEL_PROJECT_ID=prj_your-project-id
# Team id (team_...) - ONLY if the project belongs to a team; omit entirely for
# a personal account, or the Analytics API rejects the scope.
VERCEL_TEAM_ID=